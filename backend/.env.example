# --- Server ---
APP_ENV=local
FRONTEND_URL=http://localhost:5173

# --- Database ---
# SQLite for local dev. Swap for postgresql+asyncpg://user:pw@host/db in prod
# (no SQLite-specific SQL is used in the app).
DATABASE_URL=sqlite+aiosqlite:///./noted.db

# --- Session cookie (HttpOnly, signed via itsdangerous) ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=replace-me

# --- Token-at-rest encryption (Fernet) ---
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENC_KEY=replace-me

# --- Google OAuth (from Google Cloud Console -> Credentials) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# --- Atlassian OAuth 2.0 (3LO) — Phase 5 + Phase 6 ---
# Create an OAuth 2.0 integration at:
#   https://developer.atlassian.com/console/myapps/
# Add scopes: read:jira-work, read:jira-user, read:confluence-content.all,
# write:confluence-content, read:confluence-space.summary, offline_access
# Callback URL: http://localhost:8000/api/auth/atlassian/callback
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=
ATLASSIAN_REDIRECT_URI=http://localhost:8000/api/auth/atlassian/callback

# --- Drive folder IDs (Phase 2 ingestion) ---
# Open each folder in Drive; the ID is the string after `/folders/` in the URL.
DRIVE_SUMMARIES_FOLDER_ID=
DRIVE_TRANSCRIPTS_FOLDER_ID=

# --- Signed file proxy URLs (Phase 2) ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
FILE_URL_SECRET=replace-me
FILE_URL_TTL_SECONDS=600

# --- Scheduler (Phase 2) ---
SYNC_ENABLED=true
SYNC_INTERVAL_MINUTES=10
SYNC_RUN_ON_STARTUP=true

# --- Demo mode (read-time allowlists; leave blank in normal operation) ---
# Comma-separated, case-insensitive. The sync still ingests everything;
# filtering happens at the API read layer so hidden data never reaches
# the client.
#
# Meetings list / detail + calendar events: only show those whose title
# starts with one of these prefixes.
#   e.g. DEMO_MEETING_TITLE_PREFIXES=NOTED,TSD,BEST
DEMO_MEETING_TITLE_PREFIXES=
# Tickets list / detail: only show issues from these Jira projects
# (project name, exact match, case-insensitive).
#   e.g. DEMO_JIRA_PROJECT_NAMES=Noted,i2go
DEMO_JIRA_PROJECT_NAMES=
