# --- Server ---
APP_ENV=local
FRONTEND_URL=http://localhost:5173

# --- Database ---
# SQLite for local dev. Swap for postgresql+asyncpg://user:pw@host/db in prod
# (no SQLite-specific SQL is used in the app).
DATABASE_URL=sqlite+aiosqlite:///./noted.db

# --- Session cookie (HttpOnly, signed via itsdangerous) ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=replace-me

# --- Token-at-rest encryption (Fernet) ---
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENC_KEY=replace-me

# --- Google OAuth (from Google Cloud Console -> Credentials) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
